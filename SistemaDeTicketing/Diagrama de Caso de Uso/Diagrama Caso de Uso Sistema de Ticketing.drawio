<mxfile host="Electron">
  <diagram name="Página-1" id="CasoDeUso">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Contenedor del Sistema -->
        <mxCell id="system" value="Sistema de Ticketing" style="whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="400" height="400" as="geometry" />
        </mxCell>
        
        <!-- Actores -->
        <mxCell id="actor_solicitante" value="Solicitante" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="actor_admin" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="actor_tecnico" value="Técnico" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="670" y="150" width="30" height="60" as="geometry" />
        </mxCell>

        <!-- Casos de Uso -->
        <mxCell id="uc_crear" value="Crear Ticket y Asignar" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="80" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_ver" value="Ver Usuarios (Polimorfismo)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="220" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_registrar" value="Registrar Error y Escalar" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="80" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_resolver" value="Resolver y Cerrar Ticket" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="160" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_bitacora" value="Generar Bitácora" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="270" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Relaciones Asociación (Líneas simples) -->
        <mxCell id="edge_sol_crear" style="endArrow=none;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_solicitante" target="uc_crear">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_adm_crear" style="endArrow=none;html=1;rounded=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_admin" target="uc_crear">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_adm_ver" style="endArrow=none;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_admin" target="uc_ver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_tec_registrar" style="endArrow=none;html=1;rounded=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_tecnico" target="uc_registrar">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_tec_resolver" style="endArrow=none;html=1;rounded=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_tecnico" target="uc_resolver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Relaciones Dependencia (<<include>>) -->
        <mxCell id="edge_inc_registrar" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc_registrar" target="uc_bitacora">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_inc_resolver" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc_resolver" target="uc_bitacora">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
